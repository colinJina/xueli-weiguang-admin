# Copy this file to .env.local for development.
# Keep local development pointed at the same dev resources as the public site.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase credentials. Do not expose these with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY is optional unless a server-only admin path needs it.
SUPABASE_SERVICE_ROLE_KEY=

# Optional local maintenance secret. The current app does not read it directly.
SUPABASE_DB_PASSWORD=

COS_REGION=
COS_BUCKET=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_CDN_DOMAIN=
COS_UPLOAD_MAX_BYTES=52428800
